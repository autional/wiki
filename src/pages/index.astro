---
import WikiLayout from '../layouts/WikiLayout.astro';
import { services } from '../data/services';
import { t } from '../i18n';
---

<WikiLayout title={t('index.meta.title')} description={t('index.meta.description')}>
  <div class="flex-1 overflow-y-auto">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-10">
      <div class="mb-10">
        <h1 class="text-3xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900" data-i18n="index.title">{t('index.title')}</h1>
        <p class="mt-2 text-base text-neutral-500 leading-relaxed max-w-lg">
          <span data-i18n="index.leadA">{t('index.leadA')}</span><span>{services.length}</span><span data-i18n="index.leadB">{t('index.leadB')}</span>
        </p>
        <div class="mt-4 flex items-center gap-2 flex-wrap">
          <span class="brand-kicker" data-i18n="index.kicker">{t('index.kicker')}</span>
          <span class="text-xs text-[var(--color-text-muted)] font-mono"><span>{services.length}</span><span data-i18n="index.serviceCountSuffix">{t('index.serviceCountSuffix')}</span></span>
        </div>
      </div>

      <!-- service cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {services.map(s => (
          <a href={`/${s.name}/`} class="group block rounded-md border border-primary-100/80 bg-white p-5 transition hover:border-primary-300 hover:-translate-y-0.5 no-underline">
            <div class="flex items-start justify-between">
              <h2 class="text-sm font-semibold text-primary-900 group-hover:text-primary-700 transition" data-i18n={`services.${s.name}`}>{t(`services.${s.name}`)}</h2>
              <span class="text-[0.65rem] font-mono text-primary-400 shrink-0 mt-0.5">:{s.port}</span>
            </div>
            <div class="mt-3 flex items-center gap-2">
              <span class="text-[0.7rem] font-medium text-primary-500" data-i18n="index.browse">{t('index.browse')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</WikiLayout>
