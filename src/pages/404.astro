---
import WikiLayout from '../layouts/WikiLayout.astro';
import { t } from '../i18n';

// 链接文案键化；href 为站内结构路由（不随语言切换）。
const links = t('notFound.links', { returnObjects: true }) as { label: string; description: string }[];
const hrefs = ['/', '/identity-service/', '/tenant-service/', '/audit-service/'];
---

<WikiLayout
  title={t('notFound.meta.title')}
  description={t('notFound.meta.description')}
  noindex
>
  <div class="flex-1 overflow-y-auto">
    <div class="max-w-4xl mx-auto px-4 md:px-8 py-10">
      <span class="brand-kicker" data-i18n="notFound.kicker">{t('notFound.kicker')}</span>
      <h1 class="mt-5 text-3xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-900" data-i18n="notFound.title">{t('notFound.title')}</h1>
      <p class="mt-3 text-base text-neutral-500 leading-relaxed max-w-lg" data-i18n="notFound.lead">
        {t('notFound.lead')}
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {links.map((link, index) => (
          <a href={hrefs[index]} class="group block rounded-md border border-primary-100/80 bg-white p-5 transition hover:border-primary-300 hover:-translate-y-0.5 no-underline">
            <div class="text-sm font-semibold text-primary-900 group-hover:text-primary-700 transition" data-i18n={`notFound.links.${index}.label`}>{link.label}</div>
            <p class="mt-2 text-[0.8rem] leading-relaxed text-neutral-500" data-i18n={`notFound.links.${index}.description`}>{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</WikiLayout>
