{
  "name": "@autional/wiki-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gen-static": "node scripts/gen-static.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "prebuild": "node scripts/gen-static.mjs && node scripts/check-i18n.mjs",
    "predev": "node scripts/gen-static.mjs && node scripts/check-i18n.mjs",
    "dev": "astro dev --port 4435",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4435"
  },
  "dependencies": {
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.16",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.8.3"
  }
}
